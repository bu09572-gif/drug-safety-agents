---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	search(search)
	worker(worker)
	reviewer(reviewer)
	label_check(label_check)
	report(report)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	label_check --> report;
	planner --> search;
	reviewer -.-> label_check;
	reviewer -.-> worker;
	search --> worker;
	worker --> reviewer;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
